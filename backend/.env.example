# ===========================================
# 数据库配置示例
# ===========================================

# 本地 MySQL
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agent_test

# 本地 PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_test

# ===========================================
# 阿里云数据库配置示例
# ===========================================

# 阿里云 RDS MySQL
# DATABASE_URL=mysql+pymysql://用户名:密码@rm-xxxxx.mysql.rds.aliyuncs.com:3306/数据库名

# 阿里云 RDS PostgreSQL
# DATABASE_URL=postgresql://用户名:密码@pgm-xxxxx.pg.rds.aliyuncs.com:5432/数据库名

# 阿里云 PolarDB MySQL
# DATABASE_URL=mysql+pymysql://用户名:密码@pc-xxxxx.mysql.polardb.rds.aliyuncs.com:3306/数据库名

# 阿里云 PolarDB PostgreSQL
# DATABASE_URL=postgresql://用户名:密码@pc-xxxxx.pg.polardb.rds.aliyuncs.com:5432/数据库名

# ===========================================
# 注意事项
# ===========================================
# 1. 阿里云数据库需要配置白名单，允许应用服务器IP访问
# 2. 密码中的特殊字符需要URL编码，如 @ -> %40, # -> %23
# 3. 建议使用内网地址以获得更好的性能和安全性

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
